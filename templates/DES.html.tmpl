    <section class="page">
        <h2 id="section_2" class="autonumber">System Components</h2>

        <p>This section lists the components (Bitbucket repositories) of the system <em>{{metadata.configItem}}</em>.
            Only components of type <em>ods</em>, <em>ods-infra</em>, and <em>ods-service</em>
            as defined in <em>BI-IT-DEVSTACK</em> can be installed.</p>
		{{#if data.componentsDiagramPngImage}}
            The below diagram displays the components and their relations.
            <img src="data:image/png;base64,{{{data.componentsDiagramPngImage}}}" alt="System Components" class="center"/>
        {{/if}}

        <table>
            <thead>
				<th>Name</th>
				<th>Description</th>
				<th>Type</th>
				<th>Installable?</th>
				<th>Supplier</th>
                <!-- cut: BCN 3rd ws 
    				th>Version</th -->
				<th>Bitbucket URL</th>
            </thead>
            <tbody>
                {{#each data.components}}
                <tr>
                    <td class="content-wrappable" style="vertical-align: top;">{{repo.name}}</td>
                    <td class="content-wrappable" style="vertical-align: top;">{{description}}</td>
					<td class="content-wrappable" style="vertical-align: top;">{{type}}</td>
                    <td class="content-wrappable" style="vertical-align: top;">{{#if installable}}Yes{{else}}No{{/if}}</td>
                    <td class="content-wrappable" style="vertical-align: top;">{{supplier}}</td>
                    <!-- cut: BCN 3rd ws 
                        td class="content-wrappable" style="vertical-align: top;">{{version}}</td-->
                    <td class="content-wrappable break-all" style="vertical-align: top;"><div><a href="{{{repo.url}}}">{{repo.url}}</a></div></td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </section>

